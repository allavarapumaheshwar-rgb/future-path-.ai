{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://pfetvvhmnwocoffmwojf.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "futurepath-ai-06",
      "version": "0.1.0",
      "title": "FuturePath AI (06)"
    },
    "tools": [
      {
        "name": "search_colleges",
        "title": "Search colleges",
        "description": "Search FuturePath AI's college directory (500+ Indian colleges) by name, state, city, type or course.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Text to match against college name or city.",
              "type": "string",
              "maxLength": 120
            },
            "state": {
              "description": "Indian state to filter by.",
              "type": "string",
              "maxLength": 60
            },
            "type": {
              "description": "College type, e.g. Government, Private, Deemed.",
              "type": "string",
              "maxLength": 40
            },
            "course": {
              "description": "Course offered, e.g. B.Tech, MBBS.",
              "type": "string",
              "maxLength": 60
            },
            "limit": {
              "default": 10,
              "description": "Maximum results to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 25
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "search_scholarships",
        "title": "Search scholarships",
        "description": "Search FuturePath AI's scholarship hub (1000+ Indian scholarships) by name, provider type, state, level or stream.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Text to match against scholarship or provider name.",
              "type": "string",
              "maxLength": 120
            },
            "provider_type": {
              "description": "Provider type, e.g. Government, Private, NGO.",
              "type": "string",
              "maxLength": 40
            },
            "state": {
              "description": "State the scholarship applies to.",
              "type": "string",
              "maxLength": 60
            },
            "level": {
              "description": "Education level, e.g. Class 10, UG, PG.",
              "type": "string",
              "maxLength": 40
            },
            "stream": {
              "description": "Stream, e.g. Engineering, Medical, Arts.",
              "type": "string",
              "maxLength": 40
            },
            "limit": {
              "default": 10,
              "description": "Maximum results to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 25
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_saved_items",
        "title": "List saved items",
        "description": "List the signed-in student's saved careers, colleges and scholarships.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "save_college",
        "title": "Save a college",
        "description": "Add a college from the directory to the signed-in student's saved list.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "description": "College slug from search_colleges."
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "save_scholarship",
        "title": "Save a scholarship",
        "description": "Add a scholarship from the hub to the signed-in student's tracker.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "description": "Scholarship slug from search_scholarships."
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "save_career",
        "title": "Save a career",
        "description": "Bookmark a career (by its FuturePath AI slug, e.g. software-engineer) for the signed-in student.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "career_slug": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Career slug as used on /careers/<slug>."
            }
          },
          "required": [
            "career_slug"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
